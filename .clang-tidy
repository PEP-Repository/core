# Also check all non-system headers
HeaderFilterRegex: .*
# Ref: https://clang.llvm.org/extra/clang-tidy/checks/list.html
Checks:
  # Prevent duplicate warnings that we already get when running clang
  - -clang-diagnostic-*

  - bugprone-*
  - -bugprone-branch-clone
  - -bugprone-crtp-constructor-accessibility
  - -bugprone-easily-swappable-parameters
  - -bugprone-exception-escape
  #TODO(workaround) Enable when IgnoreConstantIntExpr becomes generally available
  - -bugprone-implicit-widening-of-multiplication-result
  - -bugprone-reserved-identifier # Disable as it's slow and we have -Wreserved-identifier
  - -bugprone-signed-bitwise # Signed bitwise behavior is well-defined since C++20
  - -bugprone-switch-missing-default-case
  # Suppress warnings about things like a static std::string
  - -bugprone-throwing-static-initialization
  - -bugprone-unchecked-optional-access
  # Mostly covered by -Wswitch, and conflicts with -Wcovered-switch-default
  - -bugprone-unhandled-code-paths

  - cert-dcl50-cpp
  - cert-dcl58-cpp
  - cert-err33-c
  - cert-err34-c
  - cert-err52-cpp
  - cert-err60-cpp
  - cert-msc50-cpp
  - cert-msc51-cpp
  - cert-oop57-cpp
  - cert-oop58-cpp

  - concurrency-*

  - cppcoreguidelines-avoid-capturing-lambda-coroutines
  - cppcoreguidelines-avoid-goto
  - cppcoreguidelines-avoid-non-const-global-variables
  - cppcoreguidelines-avoid-reference-coroutine-parameters
  - cppcoreguidelines-init-variables
  - cppcoreguidelines-interfaces-global-init
  - cppcoreguidelines-missing-std-forward
  - cppcoreguidelines-narrowing-conversions
  - cppcoreguidelines-no-malloc
  - cppcoreguidelines-no-suspend-with-lock
  - cppcoreguidelines-pro-type-const-cast
  - cppcoreguidelines-pro-type-cstyle-cast
  - cppcoreguidelines-pro-type-member-init
  - cppcoreguidelines-slicing
  - cppcoreguidelines-virtual-class-destructor

  - google-build-namespaces
  - google-global-names-in-headers
  - google-readability-casting
  # Don't enable as it is really slow: https://gitlab.pep.cs.ru.nl/pep/core/-/merge_requests/2176#note_51237
  #- google-runtime-int # Prefer (sized) typedefs or auto where possible
  - google-upgrade-googletest-case
  - hicpp-exception-baseclass

  - misc-confusable-identifiers
  - misc-coroutine-hostile-raii
  - misc-definitions-in-headers
  - misc-include-cleaner # Include what you use
  - misc-misleading-bidirectional
  - misc-misleading-identifier
  - misc-new-delete-overloads
  - misc-non-copyable-objects
  - misc-redundant-expression
  # Suppressed because of false positives: see https://gitlab.pep.cs.ru.nl/pep/core/-/work_items/3034
  - -misc-static-assert
  - misc-throw-by-value-catch-by-reference
  - misc-unconventional-assign-operator
  - misc-uniqueptr-reset-release
  - misc-unused-alias-decls
  - misc-unused-using-decls
  - misc-use-internal-linkage

  - modernize-avoid-c-arrays
  - modernize-deprecated-headers
  - modernize-loop-convert
  - modernize-shrink-to-fit
  - modernize-use-bool-literals
  - modernize-use-constraints
  - modernize-use-equals-default
  - modernize-use-equals-delete
  - modernize-use-nullptr
  - modernize-use-override
  - modernize-use-ranges
  - modernize-use-starts-ends-with
  - modernize-use-std-numbers

  - performance-inefficient-vector-operation
  - performance-move-const-arg
  - performance-move-constructor-init
  - performance-no-automatic-move
  - performance-type-promotion-in-math-fn

  - readability-const-return-type
  - readability-container-contains
  - readability-container-data-pointer
  - readability-duplicate-include
  - readability-misleading-indentation
  - readability-misplaced-array-index
  - readability-redundant-casting
  - readability-redundant-control-flow
  - readability-redundant-declaration
  - readability-redundant-preprocessor
  - readability-reference-to-constructed-temporary
  - readability-static-accessed-through-instance
  - readability-string-compare
  - readability-redundant-string-cstr
  - readability-suspicious-call-argument
  - readability-use-anyofallof

CheckOptions:
  # Ignore empty catch when it contains a comment with the word 'ignore'
  bugprone-empty-catch.IgnoreCatchWithKeywords: ignore
  bugprone-unused-return-value.AllowCastToVoid: true
  # Headers that misc-include-cleaner should neither require nor flag as unused (regexes, matched as suffix of the path).
  # include-cleaner suggests the header in which a symbol is declared. For the headers below, that's either a header
  # that code shouldn't include directly, or include-cleaner can't see that a header is needed.
  # Internal headers of system libraries, which implement the public headers that code should include instead:
  # - /__[^/]+/.* and /_[^/]+\.h: macOS (libc++ and the SDK), e.g. <__chrono/duration.h> (include <chrono>)
  #   and <_time.h> (include <ctime>).
  # - /bits/.*: Linux (libstdc++ and glibc), e.g. <bits/stl_vector.h> (include <vector>)
  #   and <bits/types/struct_timespec.h> (include <ctime>).
  # - /asm[^/]*/.*: Linux kernel headers, e.g. <asm-generic/errno-base.h> for EINVAL (include <cerrno>).
  # Internal headers of third-party libraries:
  # - /boost/.*/detail/.* and /boost/.*/impl/.*: Boost's implementation details.
  # - /Qt[A-Za-z]+/.*: Qt, whose lowercase headers (e.g. <qobject.h>) implement the public ones (e.g. <QObject>).
  # Forward declaration headers and their full counterparts:
  # - /boost/.*_fwd\.hpp and /nlohmann/json_fwd\.hpp: declare type aliases such as boost::property_tree::ptree,
  #   boost::format and nlohmann::json. include-cleaner would require these even when the full header is included.
  # - /boost/format\.hpp, /boost/property_tree/ptree\.hpp and /nlohmann/json\.hpp: define the classes behind those
  #   aliases. As include-cleaner attributes the aliases to the forward declaration headers, it would otherwise
  #   consider these full headers unused, even when they're needed to e.g. call member functions.
  # Headers whose use include-cleaner can't see:
  # - /rxcpp/.*: RxCpp's separate headers aren't self-contained (they need rx-lite.hpp or rx.hpp to be included first),
  #   and its operator headers implement (member) functions that are declared elsewhere.
  #   Include <rxcpp/rx-lite.hpp> plus the operator headers that you use.
  # - /pep/.*Serializers?\.hpp and /pep/weblib/Emscripten[A-Za-z]*Binding\.hpp: our (property) serializers and
  #   Emscripten bindings provide template specializations for symbols that are declared elsewhere.
  misc-include-cleaner.IgnoreHeaders: >-
    /__[^/]+/.*;
    /_[^/]+\.h;
    /bits/.*;
    /asm[^/]*/.*;
    /boost/.*/detail/.*;
    /boost/.*/impl/.*;
    /Qt[A-Za-z]+/.*;
    /boost/.*_fwd\.hpp;
    /nlohmann/json_fwd\.hpp;
    /boost/format\.hpp;
    /boost/property_tree/ptree\.hpp;
    /nlohmann/json\.hpp;
    /rxcpp/.*;
    /pep/.*Serializers?\.hpp;
    /pep/weblib/Emscripten[A-Za-z]*Binding\.hpp
  misc-throw-by-value-catch-by-reference.CheckThrowTemporaries: false
  # Aggregates may gain move operations in the future (e.g. when a string member is added)
  performance-move-const-arg.CheckTriviallyCopyableMove: false
