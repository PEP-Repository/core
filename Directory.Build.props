<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!-- Settings to improve MSBuild concurrency, for builds with CMake's Visual Studio generator. -->
  <!-- Based on https://devblogs.microsoft.com/cppblog/cpp-build-throughput-investigation-and-tune-up/ -->
  <!-- Properties can be overridden via environment variables. -->

  <!-- MSBuild imports this file for all projects in subdirectories, so for CMake build directories inside the repository
       (such as ./build), but not for build directories elsewhere, nor for dependencies that Conan builds. -->
  <!-- Measured on pep-build9 (96 vCPUs, 78 GiB RAM) in November 2026 with clean all-targets builds,
       see https://gitlab.pep.cs.ru.nl/pep/core/-/work_items/2757. -->

  <PropertyGroup>
    <!-- To enable project specific directory for temporary files.
         Recommended by the article above. Showed no measurable effect on pep-build9, but it is harmless. -->
    <PEP_UseProjectTMPDirectory Condition="'$(PEP_UseProjectTMPDirectory)' == ''">true</PEP_UseProjectTMPDirectory>

    <!-- To enable MultiToolTask (MTT) mode: MSBuild starts one cl.exe per source file, at most MultiProcMaxCount at a time.
         MultiProcMaxCount defaults to CL_MPCount (set by Visual Studio from "Tools > Options > Projects and Solutions >
         VC++ Project Settings > Maximum concurrent C++ compilations"), or else to the NUMBER_OF_PROCESSORS environment variable.
         Note that because Conan directly passes /MP, tools.build:jobs does not impact CL_MPCount. -->
    <UseMultiToolTask Condition="'$(UseMultiToolTask)' == ''">true</UseMultiToolTask>
    <!-- Enforce MultiProcMaxCount across all projects and all MSBuild instances (in the same Windows session),
         using a named semaphore. -->
    <EnforceProcessCountAcrossBuilds Condition="'$(EnforceProcessCountAcrossBuilds)' == ''">true</EnforceProcessCountAcrossBuilds>

    <!-- Do not use the MSBuild Resource Manager: with it, MTT schedules compiler processes via MSBuild
         (MultiProcSchedulerName=MsbuildProcessCounter, see Microsoft.Cpp.Common.props) instead of via the named semaphore,
         and then MultiProcMaxCount is no longer shared by concurrent MSBuild instances (i.e. concurrent CI jobs). -->
    <UseMSBuildResourceManager Condition="'$(UseMSBuildResourceManager)' == ''">false</UseMSBuildResourceManager>

    <!-- To enable experimental MTT ClServer mode (cl.exe processes are served by the MSBuild process). -->
    <EnableClServerMode Condition="'$(EnableClServerMode)' == ''">true</EnableClServerMode>

    <!-- Note: BuildPassReferences (with /t:BuildGenerateSources;BuildCompile;BuildLink) is deliberately not enabled.
         When building ALL_BUILD.vcxproj (a Utility project), as CMake's build mode does, executables link before the libraries
         they need exist (LNK1181), and on the solution it was at most ~7% faster in Release and slower in Debug. -->
  </PropertyGroup>

  <!-- Define project specific directory for temporary cl.exe files -->
  <Target Name="SetProjectTMPDirectory"
        BeforeTargets="BeforeClCompile"
        Condition="'$(DesignTimeBuild)' != 'true' and '$(PEP_UseProjectTMPDirectory)' == 'true'">
    <PropertyGroup>
      <OriginalTmp>$(TMP)</OriginalTmp>
    </PropertyGroup>
    <MakeDir Directories="$(IntDirFullPath)TMP"/>
    <SetEnv Name="TMP"
            Value="$(IntDirFullPath)TMP"
            Prefix="false">
    </SetEnv>
  </Target>

  <!-- Restore TMP directory for other tools to avoid incremental build problems -->
  <Target Name="RestoreTMPDirectory"
          BeforeTargets="AfterClCompile"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(PEP_UseProjectTMPDirectory)' == 'true'" >
    <SetEnv Name="TMP"
            Value="$(OriginalTmp)"
            Prefix="false">
    </SetEnv>
  </Target>
</Project>
