{
  "CaCertificateFile": "../../pki/rootCA.cert",
  "ListenPort": 16519,
  "TlsIdentity": {
    "PrivateKeyFile": "../../pki/TLSStorageFacility.key",
    "CertificateFile": "../../pki/TLSStorageFacility.chain"
  },
  "SigningIdentity": {
    "PrivateKeyFile": "../../pki/PEPStorageFacility.key",
    "CertificateFile": "../../pki/PEPStorageFacility.chain"
  },
  "ServerEndPoints": {
    "AccessManager": {
      "Name": "AccessManager",
      "Address": "localhost",
      "Port": 16501
    },
    "KeyServer": {
      "Name": "KeyServer",
      "Address": "localhost",
      "Port": 16511
    },
    "Transcryptor": {
      "Name": "Transcryptor",
      "Address": "localhost",
      "Port": 16516
    }
  },
  "EnrolledPartyKeysFile": "StorageFacilityKeys.json",
  "StoragePath": "meta",
  "EncIdKeyFile": "StorageFacilityEncIdKey.json",
  "PageStore": {
    "Local": {
      "DataDir": "localpagestoredata",
      "Bucket": "myBucket"
    },
    "S3": {
      "Hosts": {
        "s3proxyproxy": {
          "EndPoint": {
            "Address": "localhost",
            "Port": 9000,
            "Name": "S3"
          },
          "Credentials": {
            "AccessKey": "MyAccessKey",
            "Secret": "MySecret"
          },
          "CaCertificateFile": "../../pki/rootCA.cert"
        }
      },
      "WriteToBucket": {
        "Name": "myBucket",
        "HostId": "s3proxyproxy"
      },
      "ReadFromBuckets": [
        {
          "Name": "myBucket",
          "HostId": "s3proxyproxy"
        }
      ]
    }
  }
}
